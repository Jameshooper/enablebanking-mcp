# Enable Banking Application ID (UUID from the Enable Banking console)
ENABLE_BANKING_APP_ID=your-application-id-here

# Private key — choose ONE of the two options below:

# Option A: path to the .pem file (default)
ENABLE_BANKING_KEY_PATH=./Enable Banking Certificate.pem

# Option B: inline key content (paste between the quotes; lets you delete the .pem file)
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# MIIJQwIBADANBgkqhkiG9w0BAQEFAA...
# -----END PRIVATE KEY-----"

# Path to store active bank sessions (created automatically on first auth)
SESSIONS_FILE=./sessions.json
